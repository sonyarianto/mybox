# Rust API
PORT=3000
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://mybox:change-me-local-only@postgres:5432/mybox
SYNC_EVENT_RETENTION_SECONDS=7776000
# Keep application tombstones and CRDT delete history for at least the same
# supported offline/recovery window before asynchronous compaction.
SYNC_TOMBSTONE_RETENTION_SECONDS=7776000
# Comma-separated exact browser origins. Set this explicitly in production
# (for example, https://app.example.com). If omitted, the server derives the
# origin from AUTH_POST_LOGIN_REDIRECT and still includes
# localhost development origins.
MYBOX_ALLOWED_ORIGINS=http://localhost:8080
# Optional operator-only token for GET /internal/metrics. Leave unset to
# disable the endpoint.
MYBOX_METRICS_TOKEN=

# Local auth (opaque Postgres sessions). No external provider.
# Cookie name for the session token.
AUTH_SESSION_COOKIE=mybox_session
# Where OAuth callbacks land after sign-in.
AUTH_POST_LOGIN_REDIRECT=http://localhost:8080/
# Session lifetime in seconds (default 30 days).
AUTH_SESSION_TTL_SECS=2592000

# OAuth (optional; leave unset to offer email+password only).
# Register these redirect URIs with each provider.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback
